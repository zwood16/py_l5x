<Parameter Name="state" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Debounced device value]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="risingEdge" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[One-shot rising edge (post debounce)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="fallingEdge" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[One-shot falling edge (post debounce)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="invert" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Set to invert (NOT) the input]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="held" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[output was on longer than the hold time (useful for pushbuttons)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="holdTime" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[time output must be on before held turns on]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[500]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="500"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="risingOns" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="fallingOns" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="debounce" DataType="Debounce" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[1,0,0,[0,0,0],[0,0,0]]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="Debounce">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="0"/>
<DataValueMember Name="state" DataType="BOOL" Value="0"/>
<DataValueMember Name="onDelay" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="offDelay" DataType="DINT" Radix="Decimal" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="input" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[physical input with invert polarity applied]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="heldTimer" DataType="TIMER" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[GenericInput: adds debouncing and edge triggers to sensor and other input signals

To use:
- Place this AOI on a rung that runs every scan
- Connect the signal to monitor to the physicalInput input. This is typically from some sort of IO or ethernet device.
- Check the "state" or rising/falling Edge outputs when checking the signal]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(invert) XIO(physicalInput) ,XIO(invert) XIC(physicalInput) ]OTE(input);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[debounce the inputValue]]>
</Comment>
<Text>
<![CDATA[[MOVE(onDelay,debounce.onDelay) MOVE(offDelay,debounce.offDelay) ,XIC(input) Debounce(debounce) ,XIC(debounce.state) OTE(state) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[set the rising and falling edge ons values based on the debounced output]]>
</Comment>
<Text>
<![CDATA[XIC(debounce.state)ONS(risingOns)OTE(risingEdge);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(debounce.state)ONS(fallingOns)OTE(fallingEdge);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Check if the input is held on (useful for pushbutton logic)]]>
</Comment>
<Text>
<![CDATA[[XIC(state) MOVE(holdTime,heldTimer.PRE) TON(heldTimer,?,?) ,XIC(heldTimer.DN) OTE(held) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="FanucAlarmLookup" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2021-10-18T18:28:33.762Z" CreatedBy="A-I-CORP\ZWood" EditedDate="2023-06-27T20:02:36.212Z" EditedBy="A-I-CORP\ZWood" SoftwareRevision="v33.01">
<RevisionNote>
<![CDATA[V1.0: Initial release]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="allowableAlarms" TagType="Base" DataType="robotAlarmCode" Dimensions="20" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="robotLastAlarm" TagType="Base" DataType="robotString" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="recoverableAlarm" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="robotAlarmCode" DataType="robotAlarmCode" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,'$00$00$00$00$00$00$00$00']]]>
</DefaultData>
<DefaultData Format="String" Length="0">
<![CDATA['']]>
</DefaultData>
</LocalTag>
<LocalTag Name="length" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="j" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[Returns if the current robot alarm is allowable]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[(* ]]>
</Line>
<Line Number="1">
<![CDATA[Robot Alarm Lookup: sets recoverableAlarm to True (1) if the current robot alarm is in the allowable list. For use in FanucRobot AOI.]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[To Use: ]]>
</Line>
<Line Number="4">
<![CDATA[- Create a recoverableAlarms array externally and write the codes of any and all alarms where the robot is allowed to paused, for example: SRVO-004]]>
</Line>
<Line Number="5">
<![CDATA[- Input the robot's last alarm string]]>
</Line>
<Line Number="6">
<![CDATA[- Call once check the recoverableAlarm output to see if the current "last alarm" is within the allowableAlarms array/list]]>
</Line>
<Line Number="7">
<![CDATA[*)]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[recoverableAlarm := 0;]]>
</Line>
<Line Number="10">
<![CDATA[// Pull the alarm code out of the last alarm string. It should always be the first 8 characters.]]>
</Line>
<Line Number="11">
<![CDATA[MID(robotLastAlarm, 8, 1, robotAlarmCode);]]>
</Line>
<Line Number="12">
<![CDATA[SIZE(allowableAlarms, 0, length);]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[// Check if the alarm code matches any alarms in the allowable alarms array]]>
</Line>
<Line Number="15">
<![CDATA[FOR j:=0 TO length - 1 BY 1 DO]]>
</Line>
<Line Number="16">
<![CDATA[	IF robotAlarmCode = allowableAlarms[j] THEN]]>
</Line>
<Line Number="17">
<![CDATA[		recoverableAlarm := 1;]]>
</Line>
<Line Number="18">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="19">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="20">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="FanucPNS" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true" CreatedDate="2016-04-06T17:38:41.989Z" CreatedBy="A-I-CORP\zwood" EditedDate="2023-06-28T17:55:09.879Z" EditedBy="A-I-CORP\ZWood" SoftwareRevision="v33.01">
<RevisionNote>
<![CDATA[V1.1 Updated documentation
V1.0: Modernized version of PNS_Action designed for use with the fanucRobot AOI. Changes from PNS_Action V3 include:  
- Updated to use UI and UO data types
- Adjusted tag names to camelCase
- Change faults to bit addressed instead of a single code]]>
</RevisionNote>
<Parameters>
