<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="faulted" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="statusCode" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="done" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="programNumber" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="UI" TagType="Base" DataType="robotUI" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="UO" TagType="Base" DataType="robotUO" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="Step" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="watchdogTimer" DataType="TIMER" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,3000,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="3000"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="ons" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="ack" DataType="SINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="pns" DataType="SINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<Description>
<![CDATA[EnableInFalse]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Reset values when AOI is not running]]>
</Comment>
<Text>
<![CDATA[OTU(ons.0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[OTU(UI.pnsStrobe);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[RES(watchdogTimer);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FanucPNS: Call a robot program using the Program Number Select (PNS) protocol via the UOP (User Operator Panel) signals.

To Use: 
- Set a program number
- Input the robot's UO signals
- Output the robot's UI signals
- Call to run the PNS sequence and wait for the done or faulted output

The robot should have the following settings (found under system->config settings)
Enable UI signals : true
START for CONTINUE only : false
CSTOPI for ABORT : true
abort all programs by CSTOPI : true
PROD_START depend on PNSSTROBE : true

Required Starting Conditions:
CMD Enable and System Ready UOPs on ON
UI and UO variables must be mapped to Robot IN/OUT UOP signals externally
Robot is not already running a program

Fault Codes (bit addressed)
Bit 0 - CMD_ENABLED UOP is not on (check IMSPOP, HOLD, SFPD, ENABLE and Manual/Auto state of the robot)
Bit 1 - System_Ready UOP is not on (check the same things as CMD_ENABLED) & Robot Fault
Bit 2 - PNS Watchdog Timer Triggered. Process could not complete
Bit 3 - PNS outputs do not match inputs after cycling the PNSStrobe. 
Bit 4 - Program already running. Cycle Stop before calling PNS Action]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Start PNS Action on when AOI is enabled.
Reset Status Bits/Codes
Make Sure UOP Outputs are in correct state]]>
</Comment>
<Text>
<![CDATA[ONS(ons.0)[OTU(done) ,OTL(busy) ,MOVE(0,fault) ,MOVE(10,Step) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Enable Watchdog Timer. If PNS Action exceeds time limit, flag error]]>
</Comment>
<Text>
<![CDATA[[TON(watchdogTimer,?,?) ,XIC(watchdogTimer.DN) MOVE(0,Step) OTL(fault.2) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Set the Status Code]]>
</Comment>
<Text>
<![CDATA[MOVE(Step,statusCode);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Error State

Unlatch Busy and do nothing]]>
</Comment>
<Text>
<![CDATA[EQ(Step,0)OTU(busy);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[NE(fault,0)OTE(faulted);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Map PNS and ACK bits to numbers]]>
</Comment>
<Text>
<![CDATA[[XIC(UO.ack1) OTE(ack.0) ,XIC(UO.ack2) OTE(ack.1) ,XIC(UO.ack3) OTE(ack.2) ,XIC(UO.ack4) OTE(ack.3) ,XIC(UO.ack5) OTE(ack.4) ,XIC(UO.ack6) OTE(ack.5) ,XIC(UO.ack7) OTE(ack.6) ,XIC(UO.ack8) OTE(ack.7) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[
]]>
</Comment>
<Text>
<![CDATA[[XIC(pns.0) OTE(UI.pns1) ,XIC(pns.1) OTE(UI.pns2) ,XIC(pns.2) OTE(UI.pns3) ,XIC(pns.3) OTE(UI.pns4) ,XIC(pns.4) OTE(UI.pns5) ,XIC(pns.5) OTE(UI.pns6) ,XIC(pns.6) OTE(UI.pns7) ,XIC(pns.7) OTE(UI.pns8) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Check Some Starting Conditions]]>
</Comment>
<Text>
<![CDATA[EQ(Step,10)[XIC(UO.cmdEnable) XIC(UO.systemReady) XIO(UO.prgRunning) MOVE(20,Step) ,[XIO(UO.cmdEnable) OTL(fault.0) ,XIO(UO.systemReady) OTL(fault.1) ,XIC(UO.prgRunning) OTL(fault.4) ] MOVE(0,Step) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Set Program Number and SNACK (signal robot to look at program number) & wait for robot to acknowledge

Set Prod Start High (program will start on falling edge)]]>
</Comment>
<Text>
<![CDATA[EQ(Step,20)[MOVE(programNumber,pns) ,OTL(UI.pnsStrobe) ,OTL(UI.prodStart) ,XIC(UO.snack) MOVE(30,Step) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Check that the Robot Acknowledged the correct program and start if it did.

Otherwise flag as an error]]>
</Comment>
<Text>
<![CDATA[EQ(Step,30)[EQ(programNumber,ack) OTU(UI.prodStart) MOVE(40,Step) ,NE(programNumber,ack) OTL(fault.3) MOVE(0,Step) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Check that Program is Running. If it is, signal that PNS is done]]>
</Comment>
<Text>
<![CDATA[EQ(Step,40)XIC(UO.prgRunning)[OTL(done) OTU(busy) ,MOVE(0,Step) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="SeqCtrl" Revision="3.3" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-04-12T15:18:43.317Z" CreatedBy="A-I-CORP\ZWood" EditedDate="2024-09-04T21:38:06.473Z" EditedBy="A-I-CORP\ZWood" SoftwareRevision="v35.01">
<RevisionNote>
<![CDATA[v3.3 Fixed bug where state bits and step where out of sync for 1 scan
v3.2 fixed bug where first scan would not init to aborted
v3.1 add state back in and inActiveState outputs and fixed abortVisible bug
v3.0 Major overhaul of states, cmds, UDTs, etc. See AIC Wiki for details.
...]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="mode" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[System Mode. 0 = Manual (enable HMI). 1 = Auto (disable HMI)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="autoModeOverride" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Optional bit to externally change the mode to run Auto Mode Code while in Manual Mode]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="disableHmiStart" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Typically tied to estop. Set to 0 to ignore]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="faulted" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Seq faulted ind]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="running" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Steps 0 - 1999]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="complete" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Step 2000]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="pausing" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Steps 3000-3999]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="paused" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Step 4000]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="restarting" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Steps 5000-5999]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="aborting" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Steps 6000-6999]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="aborted" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Step 7000]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="inAnActiveState" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Seq is executing code]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="cmdStart" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Set on to start/restart the sequence]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="cmdPause" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Set on to pause or hold a running sequence]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="cmdAbort" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Set on to immeditely stop a sequence]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="autoStep" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Enables automatic step transitions]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="singleStep" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Enables a single step transition when autoStep = False]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="hmiCmdStart" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[HMI start command. Enabled when mode = False]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="hmiCmdPause" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[HMI pause command. Enabled when mode = False]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="hmiCmdAbort" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[HMI abort command. Enabled when mode = False]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="hmiStartVisible" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[HMIi start button enable]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="hmiPauseVisible" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[HMI pause button enable]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="hmiAbortVisible" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[HMI abort button enable]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="currentStep" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Active Step Number]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[7000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="7000"/>
</DefaultData>
</Parameter>
<Parameter Name="nextStep" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Next Step Number]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[7000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="7000"/>
</DefaultData>
</Parameter>
<Parameter Name="fault" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Fault code(s). Typically bit addressed]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="ons" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bits for external ONS use]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="stepBeforeAbort" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[The step number before the most recent successful abort command]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="stepBeforePause" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[The step number before the most recent successful hold command]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="runningStepBeforePause" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[The running step before the last pause.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="state" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Bit address state indicator for certain more limited HMIs]]>
</Description>
<Comments>
<Comment Operand=".0">
<![CDATA[running]]>
</Comment>
<Comment Operand=".1">
<![CDATA[complete]]>
</Comment>
<Comment Operand=".2">
<![CDATA[pausing]]>
</Comment>
<Comment Operand=".3">
<![CDATA[paused]]>
</Comment>
<Comment Operand=".4">
<![CDATA[restarting]]>
</Comment>
<Comment Operand=".5">
<![CDATA[aborting]]>
</Comment>
<Comment Operand=".6">
<![CDATA[aborted]]>
</Comment>
</Comments>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="startupStep" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Step which sequence will init to on first scan. Defaults to aborted]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[7000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="7000"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="internalOns" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="hmiModeSel" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="watchdog" DataType="TIMER" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="stateUpdated" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[SeqCtrl: Handles the basic logic for state transitions and HMI handling for sequences. 

To Use:
	- Place on a rung that runs every scan BEFORE any of the steps
	- Map/set the mode input to True (1) to disable HMI control. 
	- Map/Set the disableHmiStart input to True (1) to disable the HMI start button, typically for when the safety system is not in a safe state.

Sequences, written externally, should always be interacted with by using the following inputs:
- cmdStart
- cmdAbort
- cmdPause
- nextStep

NEVER write directly to currentStep.

See AIC Wiki for more details]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Change the startup step on first scan/power on
]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)MOVE(startupStep,currentStep)MOVE(startupStep,nextStep);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Use a bool and jump label to updated the state (running/aborted/etc) bits twice. 
- Once here at the beginning before we check what commands are valid, and 
- a second time at the end once the step has been updated]]>
</Comment>
<Text>
<![CDATA[XIO(stateUpdated)JMP(updateState);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[LBL(begin)NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Set the current "mode"
need to have a pseudo-automode when running code so that IO will respond, but system is not in full running/automode]]>
</Comment>
<Text>
<![CDATA[XIC(mode)XIO(autoModeOverride)OTE(hmiModeSel);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[/////////   HMI Button Handling   /////////

When valid, set the corresponding PLC command(s) when the HMI requests it. HMI should Set On the commands (once) and this program will turn them off.

Start Button]]>
</Comment>
<Text>
<![CDATA[XIC(hmiCmdStart)ONS(internalOns.1)[XIO(hmiModeSel) XIO(disableHmiStart) OTL(cmdStart) OTL(autoModeOverride) ,OTU(hmiCmdStart) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Start Button Visibility]]>
</Comment>
<Text>
<![CDATA[XIO(hmiModeSel)XIO(disableHmiStart)[XIC(complete) ,XIC(paused) ,XIC(aborted) ]OTE(hmiStartVisible);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Abort]]>
</Comment>
<Text>
<![CDATA[XIC(hmiCmdAbort)ONS(internalOns.2)[XIO(hmiModeSel) OTL(cmdAbort) OTL(autoModeOverride) ,OTU(hmiCmdAbort) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Abort Button Visibility]]>
</Comment>
<Text>
<![CDATA[XIO(hmiModeSel)XIO(complete)XIO(aborted)OTE(hmiAbortVisible);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Pause (Hold)]]>
</Comment>
<Text>
<![CDATA[XIC(hmiCmdPause)ONS(internalOns.4)[XIO(hmiModeSel) OTL(cmdPause) OTL(autoModeOverride) ,OTU(hmiCmdPause) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Hold Button Visibility]]>
</Comment>
<Text>
<![CDATA[XIO(hmiModeSel)[XIC(running) ,XIC(pausing) ,XIC(restarting) ]OTE(hmiPauseVisible);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Reset AutoMode Override]]>
</Comment>
<Text>
<![CDATA[[XIC(aborted) ONS(internalOns.7) ,XIC(complete) ONS(internalOns.8) ,XIC(paused) ONS(internalOns.9) ]OTU(autoModeOverride);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[In Active State: a shortcut to check if the sequence is running code vs is in and idle state]]>
</Comment>
<Text>
<![CDATA[[XIC(running) ,XIC(pausing) ,XIC(restarting) ,XIC(aborting) ]OTE(inAnActiveState);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[/////////   Reject Invalid CMDs   /////////

Prevents random bits from getting latched on and causing unexpected execution


]]>
</Comment>
<Text>
<![CDATA[XIC(cmdAbort)[XIC(complete) ,XIC(aborting) ,XIC(aborted) ]OTU(cmdAbort)OTU(autoModeOverride);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(cmdStart)XIO(complete)XIO(aborted)XIO(paused)OTU(cmdStart)OTU(autoModeOverride);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(cmdPause)XIO(running)XIO(restarting)OTU(cmdPause)OTU(autoModeOverride);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[/////////   Parse Commands and Transition States   //////////

Any state transition that requires a command should be handled here. Exceptions are:
- going from running to complete
- going from pausing to paused
- going from aborting to aborted

Respond to start command. Varies based on state]]>
</Comment>
<Text>
<![CDATA[XIC(cmdStart)[[XIC(complete) ,XIC(aborted) ] MOVE(0,nextStep) ,XIC(paused) MOVE(5000,nextStep) ,OTU(cmdStart) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Respond to pause command

]]>
</Comment>
<Text>
<![CDATA[XIC(cmdPause)[MOVE(3000,nextStep) ,ONS(internalOns.13) [MOVE(currentStep,stepBeforePause) ,XIC(running) MOVE(currentStep,runningStepBeforePause) ] ,OTU(cmdPause) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[
Respond to Abort Command

]]>
</Comment>
<Text>
<![CDATA[XIC(cmdAbort)[MOVE(6000,nextStep) ,ONS(internalOns.12) MOVE(currentStep,stepBeforeAbort) ,OTU(cmdAbort) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[/////////   Step Control   /////////

Enable autoStep to run code normally
Disable autoStep and manually toggle singleStep for control of sequence execution

NOTE: This should be last rung of any sort of step control logic so that all parsing and checks of commands happen before the step number acutally changes.

]]>
</Comment>
<Text>
<![CDATA[[XIC(autoStep) ,XIC(singleStep) ][MOVE(nextStep,currentStep) ,OTU(singleStep) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[LBL(updateState)NOP();]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[/////////   Set Status Bits   /////////


Running Status]]>
</Comment>
<Text>
<![CDATA[LIMIT(0,currentStep,1999)OTE(running);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Complete Status]]>
</Comment>
<Text>
<![CDATA[EQ(currentStep,2000)OTE(complete);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Pausing Status]]>
</Comment>
<Text>
<![CDATA[LIMIT(3000,currentStep,3999)OTE(pausing);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Paused Status]]>
</Comment>
<Text>
<![CDATA[EQ(currentStep,4000)OTE(paused);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Restarting Status]]>
</Comment>
<Text>
<![CDATA[LIMIT(5000,currentStep,5999)OTE(restarting);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Aborting Status]]>
</Comment>
<Text>
<![CDATA[LIMIT(6000,currentStep,6999)OTE(aborting);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Aborted Status]]>
</Comment>
<Text>
<![CDATA[EQ(currentStep,7000)OTE(aborted);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[Use stateUpdated bit to call this chunk of code twice. Once at the beginning in case someone messed with currentStep and then at the end in normal order to reflect what changed]]>
</Comment>
<Text>
<![CDATA[XIO(stateUpdated)OTL(stateUpdated)JMP(begin);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[OTU(stateUpdated);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[/////////   Faulted Status   /////////

Set faulted status bit if any fault bit is set on]]>
</Comment>
<Text>
<![CDATA[NE(fault,0)OTE(faulted);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[Create a bit addressed state output for HMIs with limited functionality (like C-More or View Studio)]]>
</Comment>
<Text>
<![CDATA[XIC(running)OTE(state.0);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(complete)OTE(state.1);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[XIC(pausing)OTE(state.2);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIC(paused)OTE(state.3);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[XIC(restarting)OTE(state.4);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[XIC(aborting)OTE(state.5);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[XIC(aborted)OTE(state.6);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="FanucRobot" Revision="1.4" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2021-10-18T17:00:59.819Z" CreatedBy="A-I-CORP\ZWood" EditedDate="2025-11-19T02:25:29.668Z" EditedBy="ROCKWELL-VM\Zac" SoftwareRevision="v37.00">
<RevisionNote>
<![CDATA[v1.4: added faulted status
V1.3 - added seq faults to reset input and fixed some issues with auto aborting
V1.2 - Updated to Seq V3.2
V1.1 - Updated to Seq V3.1
V1.0 - Updated for new seq
V0.2 - Updated to use fanucPNS instead of PNS_Action
V0.1 - Inital Release
]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="seq" TagType="Base" DataType="SeqCtrl" Usage="InOut" Required="true" Visible="true" Constant="false">
<Comments>
<Comment Operand=".FAULT.0">
<![CDATA[Robot fault did not reset when running]]>
</Comment>
<Comment Operand=".FAULT.1">
<![CDATA[Robot did not stop (cstopi)]]>
</Comment>
<Comment Operand=".FAULT.2">
<![CDATA[CMD Enable not on]]>
</Comment>
<Comment Operand=".FAULT.3">
<![CDATA[System Ready not on]]>
</Comment>
<Comment Operand=".FAULT.4">
<![CDATA[Prog Num Select took too long]]>
</Comment>
<Comment Operand=".FAULT.5">
<![CDATA[Program Number Echo did not match]]>
</Comment>
<Comment Operand=".FAULT.6">
<![CDATA[Program already running]]>
</Comment>
<Comment Operand=".FAULT.7">
<![CDATA[Robot did not reset fault during restart]]>
</Comment>
<Comment Operand=".FAULT.8">
<![CDATA[Robot did not restart]]>
</Comment>
<Comment Operand=".FAULT.9">
<![CDATA[Robot aborted itself]]>
</Comment>
<Comment Operand=".FAULT.10">
<![CDATA[Robot alarm not recoverable. Robot aborted]]>
</Comment>
<Comment Operand=".FAULT.11">
<![CDATA[Robot did not Hold (pause)]]>
</Comment>
</Comments>
</Parameter>
