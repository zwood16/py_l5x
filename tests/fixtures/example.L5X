<Routine Name="StructuredTextRoutine" Type="ST">
<Description>
<![CDATA[A routine written using structured text]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[(*]]>
</Line>
<Line Number="1">
<![CDATA[Example of a structured text program. Loops through an inc a number]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[This is a multiline comment]]>
</Line>
<Line Number="4">
<![CDATA[	- Some indented text]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[*)]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[// loop here]]>
</Line>
<Line Number="9">
<![CDATA[j := 0;]]>
</Line>
<Line Number="10">
<![CDATA[for i:=0 to 31 by 1 do]]>
</Line>
<Line Number="11">
<![CDATA[	if i mod 2 = 1 then]]>
</Line>
<Line Number="12">
<![CDATA[		j := j+1;]]>
</Line>
<Line Number="13">
<![CDATA[	end_if;]]>
</Line>
<Line Number="14">
<![CDATA[end_for;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[// multiline if]]>
</Line>
<Line Number="17">
<![CDATA[IF j <> 0 and]]>
</Line>
<Line Number="18">
<![CDATA[	j < 32 THEN]]>
</Line>
<Line Number="19">
<![CDATA[	// some comment]]>
</Line>
<Line Number="20">
<![CDATA[	// another comment nearby]]>
</Line>
<Line Number="21">
<![CDATA[	j:= 32;]]>
</Line>
<Line Number="22">
<![CDATA[	]]>
</Line>
<Line Number="23">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
