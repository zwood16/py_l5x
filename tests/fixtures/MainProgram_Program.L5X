<DataValueMember Name="cmdAbort" DataType="BOOL" Value="0"/>
<DataValueMember Name="autoStep" DataType="BOOL" Value="0"/>
<DataValueMember Name="singleStep" DataType="BOOL" Value="0"/>
<DataValueMember Name="hmiCmdStart" DataType="BOOL" Value="0"/>
<DataValueMember Name="hmiCmdPause" DataType="BOOL" Value="0"/>
<DataValueMember Name="hmiCmdAbort" DataType="BOOL" Value="0"/>
<DataValueMember Name="hmiStartVisible" DataType="BOOL" Value="0"/>
<DataValueMember Name="hmiPauseVisible" DataType="BOOL" Value="0"/>
<DataValueMember Name="hmiAbortVisible" DataType="BOOL" Value="0"/>
<DataValueMember Name="currentStep" DataType="DINT" Radix="Decimal" Value="7000"/>
<DataValueMember Name="nextStep" DataType="DINT" Radix="Decimal" Value="7000"/>
<DataValueMember Name="fault" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ons" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="stepBeforeAbort" DataType="DINT" Radix="Decimal" Value="5000"/>
<DataValueMember Name="stepBeforePause" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="runningStepBeforePause" DataType="DINT" Radix="Decimal" Value="0"/>
