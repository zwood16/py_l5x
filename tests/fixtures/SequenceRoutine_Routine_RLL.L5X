<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="37.00" TargetName="SequenceRoutine" TargetType="Routine" TargetSubType="RLL" ContainsContext="true" ExportDate="Thu Jul 09 14:04:07 2026" ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies ForceProtectedEncoding AllProjDocTrans">
